set nocompatible
filetype plugin indent on
syntax on

set tabstop=2 shiftwidth=2 expandtab
set smartindent autoindent

set number relativenumber
set colorcolumn=0
set laststatus=2 ruler showcmd
set scrolloff=5

set incsearch hlsearch ignorecase smartcase

set clipboard=unnamedplus
set backspace=indent,eol,start
set wildmenu wildmode=longest:full,full
set mouse=a
set splitright splitbelow
set noswapfile
set encoding=utf-8
set hidden

let mapleader = " "

inoremap jk <Esc>
nnoremap <leader>w :w<CR>
nnoremap <leader>h :nohlsearch<CR>
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

nnoremap <leader>t :term<CR>
nnoremap <leader>i :vsp input.txt<CR>
nnoremap <leader>o :vsp output.txt<CR>

" --- Execuções (Normal / Doludu / Sanitizers) ---
" Compilador do Sanitizers:
"   Linux/WSL:      'g++'     (já traz libasan/libubsan)
"   MSYS2 CLANG64:  'clang++' (o g++ do UCRT64 não tem sanitizers)
let g:san_cxx = 'g++'

let g:flags_normal = '-Wall -Wextra -Wshadow -D_GLIBCXX_DEBUG -D_GLIBCXX_DEBUG_PEDANTIC'
let g:flags_doludu = g:flags_normal . ' -DDoludu'
" Com clang++/libc++, remova o -D_GLIBCXX_DEBUG daqui
let g:flags_san    = '-Wall -Wextra -Wshadow -D_GLIBCXX_DEBUG -DLOCAL -fsanitize=address,undefined'

" cxx, flags, entrada ('' = interativo, 'input.txt' = redireciona), saída ('' ou 'output.txt')
function! RunCpp(cxx, flags, infile, outfile)
  write
  let l:cmd = a:cxx . ' % -std=c++23 ' . a:flags . ' -g -o %:r && ./%:r -debug'
  if a:infile !=# ''
    let l:cmd .= ' < ' . a:infile
  endif
  if a:outfile !=# ''
    let l:cmd .= ' > ' . a:outfile . ' 2>&1'
  endif
  execute '!' . l:cmd
endfunction

" Interativo (digita a entrada no terminal)
nnoremap <F5> :call RunCpp('g++', g:flags_normal, '', '')<CR>
nnoremap <F6> :call RunCpp('g++', g:flags_doludu, '', '')<CR>
nnoremap <F7> :call RunCpp(g:san_cxx, g:flags_san, '', '')<CR>

" Lendo de input.txt
nnoremap <leader>1 :call RunCpp('g++', g:flags_normal, 'input.txt', '')<CR>
nnoremap <leader>2 :call RunCpp('g++', g:flags_doludu, 'input.txt', '')<CR>
nnoremap <leader>3 :call RunCpp(g:san_cxx, g:flags_san, 'input.txt', '')<CR>

" Normal: input.txt -> output.txt (sem mostrar na tela)
nnoremap <F8> :call RunCpp('g++', g:flags_normal, 'input.txt', 'output.txt')<CR>

nnoremap <leader>cp :-1read ~/.vim/templates/cp.cpp<CR>

autocmd FileType cpp setlocal commentstring=//\ %s
inoremap { {}<Left>
inoremap [ []<Left>
inoremap ( ()<Left>
inoremap <expr> ) getline('.')[col('.')-1]==')' ? "\<Right>" : ")"
inoremap <expr> ] getline('.')[col('.')-1]==']' ? "\<Right>" : "]"
inoremap <expr> } getline('.')[col('.')-1]=='}' ? "\<Right>" : "}"

" Underline no normal mode, barra no insert mode
let &t_EI = "\e[4 q"  " normal: underline
let &t_SI = "\e[6 q"  " insert: barra
let &t_SR = "\e[4 q"  " replace: underline

" --- Formatador ---
autocmd FileType cpp setlocal formatprg=clang-format\ --style=Google
nnoremap <leader>f :%!clang-format --style=Google<CR>
vnoremap <leader>f :!clang-format --style=Google<CR>

